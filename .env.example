POSTGRES_DB=contribute
POSTGRES_USER=contribute
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://contribute:change-me@postgres:5432/contribute
HOST_DATABASE_URL=postgresql://contribute:change-me@127.0.0.1:5432/contribute
API_TOKEN=replace-with-a-long-random-token
API_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:8000,https://contribute-drab.vercel.app
DASHBOARD_URL=https://contribute-drab.vercel.app/radar.html
REVIEW_BASE_URL=http://127.0.0.1:8080
HERMES_BINARY=hermes
# Leave blank to use the only Discord DM in ~/.hermes/channel_directory.json.
HERMES_DISCORD_TARGET=
AUTO_SUBMIT=false
APPLICATION_BATCH_LIMIT=2
# Optional comma-separated role IDs for an exact canary batch.
CANARY_ROLE_IDS=
HERMES_TIMEZONE=America/Chicago
ALLOWED_SEASONS=summer-2027
HERMES_HEADLESS=true
APPLICATION_ACCOUNT_EMAIL=
APPLICATION_ACCOUNT_PASSWORD=
PROFILE_PATH=config/profile.toml
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
