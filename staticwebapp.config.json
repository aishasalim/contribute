{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/data/*", "/*.json", "/*.{png,jpg,svg,ico,css,js}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "cache-control": "no-cache"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
